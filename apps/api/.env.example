# ---- Core
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000

# ---- Database (Neon in production: pooled URL for DATABASE_URL, direct URL for migrations)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hisabkhata?schema=public
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hisabkhata?schema=public

# ---- Redis (Upstash in production: rediss://default:<password>@<host>:6379)
REDIS_URL=redis://localhost:6379
# Set to false to run without Redis (emails/jobs are processed inline). Useful for tests.
QUEUES_ENABLED=true

# ---- Auth (generate with: openssl rand -base64 48)
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_DOMAIN=
# "lax" when web and api share a site; "none" when they are on different sites (Vercel + Render)
COOKIE_SAMESITE=lax

# ---- Email
MAIL_FROM="HisabKhata <no-reply@hisabkhata.local>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ---- File storage: local | cloudinary
STORAGE_DRIVER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Payments (SSLCommerz sandbox by default)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true

# ---- Seed
SEED_SUPERADMIN_EMAIL=admin@hisabkhata.local
SEED_SUPERADMIN_PASSWORD=Admin12345
SEED_DEMO_DATA=true
