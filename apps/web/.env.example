# Where Next.js proxies /api/* (server-side only). Locally the NestJS dev server; in production the Render URL.
API_ORIGIN=http://localhost:4000

# ---- Public site details (optional). Anything left empty is hidden on the site.
# Canonical URL used for Open Graph links.
NEXT_PUBLIC_SITE_URL=
# WhatsApp number with country code, digits only (e.g. 8801712345678). Shows a "Chat on WhatsApp" button.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Phone and email shown on the Contact page.
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=
# Social links shown in the footer.
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_LINKEDIN_URL=
