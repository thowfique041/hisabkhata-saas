{
  "name": "hisabkhata",
  "private": true,
  "version": "0.1.0",
  "description": "HisabKhata: multi-tenant inventory, POS, invoicing and business management SaaS",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=20.18" },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/** dev",
    "dev:api": "pnpm --filter @hisabkhata/api dev",
    "dev:web": "pnpm --filter @hisabkhata/web dev",
    "build": "pnpm --filter @hisabkhata/shared build && pnpm -r --filter ./apps/** build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @hisabkhata/api test",
    "test:e2e": "pnpm --filter @hisabkhata/api test:e2e",
    "db:migrate": "pnpm --filter @hisabkhata/api prisma:migrate",
    "db:deploy": "pnpm --filter @hisabkhata/api prisma:deploy",
    "db:seed": "pnpm --filter @hisabkhata/api seed",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,css,yml}\"",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "typescript": "~5.6.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,json,css,md,yml}": "prettier --write"
  }
}
